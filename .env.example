# Supabase (see docs/SUPABASE_SETUP.md)
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat — THREE different public keys. Do not mix prefixes.
# Mixing causes: "Invalid API key. Use your Web Billing API key."
# VITE_REVENUECAT_PUBLIC_KEY=rcb_...          # Web Billing ONLY (Safari / kalunez.com)
# VITE_REVENUECAT_IOS_PUBLIC_KEY=appl_...     # iOS TestFlight / App Store ONLY
# VITE_REVENUECAT_ANDROID_PUBLIC_KEY=goog_... # Google Play ONLY

# PostHog analytics (requires cookie consent — "Accept all")
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Sentry error monitoring
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_ENABLED=true

# LiveKit (browser streaming)
# VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Mux (OBS/RTMP streaming)
# VITE_MUX_ENABLED=true

# --- Supabase Edge Function secrets (set via `supabase secrets set`, NOT here) ---
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# STRIPE_API_KEY=sk_live_...          # payout rail only — see docs/PAYMENTS.md
# APP_URL=https://www.kalunez.com
# REVENUECAT_WEBHOOK_AUTH=            # shared secret configured in RevenueCat webhook settings
# SUPABASE_SERVICE_ROLE_KEY=          # auto-provided by Supabase in Edge Function runtime
